#!/usr/bin/env bash
#
# Spec lint: enforce the conventions of the spec-driven development flow
# (docs/development/spec-driven-development.md) so specs stay consistent and
# reviewable.
#
# For every feature spec docs/features/NNNN-*.md it checks:
#   * the filename starts with a 4-digit zero-padded, unique number;
#   * YAML frontmatter with id (matching the filename), title, a valid status
#     (ready|in-progress|implemented|superseded), and an owner;
#   * all required section headings are present;
#   * the "Open Questions" section has NO unresolved checkbox items ("- [ ]") --
#     a spec may not be committed with open questions (resolve them into
#     Decisions first; pre-ready thinking lives in docs/proposals/);
#   * the spec is listed in the docs/features/README.md index.
#
# TEMPLATE.md and README.md are not specs and are skipped.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

FEATURES_DIR="docs/features"
INDEX="$FEATURES_DIR/README.md"

REQUIRED_SECTIONS=(
  "## Summary"
  "## Goals"
  "## Non-Goals"
  "## Background / Context"
  "## Design"
  "## Security Considerations"
  "## Decisions"
  "## Open Questions"
  "## Acceptance Criteria"
  "## Implementation Plan"
  "## Notes"
)

VALID_STATUS_RE='^status:[[:space:]]*(ready|in-progress|implemented|superseded)[[:space:]]*(#.*)?$'

errors=0
err() {
  echo "lint-specs: $1" >&2
  errors=$((errors + 1))
}

if [[ ! -f "$INDEX" ]]; then
  err "missing index $INDEX"
fi

declare -A seen_numbers=()

shopt -s nullglob
specs=("$FEATURES_DIR"/[0-9]*.md)
shopt -u nullglob

for spec in "${specs[@]}"; do
  base="$(basename "$spec")"

  # Filename must be NNNN-something.md with a 4-digit zero-padded number.
  if [[ ! "$base" =~ ^([0-9]{4})-[a-z0-9-]+\.md$ ]]; then
    err "$base: filename must match NNNN-kebab-title.md (4-digit number)"
    continue
  fi
  number="${BASH_REMATCH[1]}"

  if [[ -n "${seen_numbers[$number]+x}" ]]; then
    err "$base: duplicate spec number $number (also ${seen_numbers[$number]})"
  fi
  seen_numbers[$number]="$base"

  # --- Frontmatter ---------------------------------------------------------
  # Must open with a YAML frontmatter block delimited by '---' lines.
  if [[ "$(sed -n '1p' "$spec")" != "---" ]]; then
    err "$base: must start with a YAML frontmatter '---' line"
    continue
  fi
  # Extract the frontmatter block (between the first two '---' lines).
  frontmatter="$(awk 'NR==1 && $0=="---"{f=1;next} f && $0=="---"{exit} f{print}' "$spec")"

  # id: must match the filename number.
  id_line="$(grep -E '^id:' <<< "$frontmatter" || true)"
  if [[ -z "$id_line" ]]; then
    err "$base: frontmatter missing 'id:'"
  else
    id_val="$(sed -E 's/^id:[[:space:]]*//; s/[[:space:]]*$//' <<< "$id_line")"
    if [[ "$id_val" != "$number" ]]; then
      err "$base: frontmatter id '$id_val' does not match filename number '$number'"
    fi
  fi

  # title: must be present and non-empty.
  if ! grep -Eq '^title:[[:space:]]*\S' <<< "$frontmatter"; then
    err "$base: frontmatter missing non-empty 'title:'"
  fi

  # status: must be one of the valid values.
  if ! grep -Eq "$VALID_STATUS_RE" <<< "$frontmatter"; then
    err "$base: frontmatter missing or invalid 'status:' (ready|in-progress|implemented|superseded)"
  fi

  # owner: must be present and non-empty.
  if ! grep -Eq '^owner:[[:space:]]*\S' <<< "$frontmatter"; then
    err "$base: frontmatter missing non-empty 'owner:'"
  fi

  # --- Required sections ---------------------------------------------------
  for section in "${REQUIRED_SECTIONS[@]}"; do
    if ! grep -Fxq "$section" "$spec"; then
      err "$base: missing required section '$section'"
    fi
  done

  # --- Open Questions must be resolved -------------------------------------
  # Extract the body of the "## Open Questions" section (up to the next "## ")
  # and fail if it contains any unresolved checkbox ("- [ ]").
  open_questions="$(awk '
    /^## Open Questions[[:space:]]*$/ { grab=1; next }
    grab && /^## / { grab=0 }
    grab { print }
  ' "$spec")"
  if grep -Eq '^[[:space:]]*-[[:space:]]*\[[[:space:]]\]' <<< "$open_questions"; then
    err "$base: 'Open Questions' has unresolved items ('- [ ]'); resolve them into Decisions before committing"
  fi

  # --- Index linkage -------------------------------------------------------
  if [[ -f "$INDEX" ]] && ! grep -q "($base)" "$INDEX"; then
    err "$base: not listed in $INDEX index"
  fi
done

if (( errors > 0 )); then
  echo "lint-specs: FAIL ($errors problem(s))" >&2
  exit 1
fi

echo "lint-specs: OK (${#specs[@]} spec(s))"
